{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recipe",
  "type": "object",
  "properties": {
    "nand": {
      "description": "The NAND image to build.",
      "$ref": "#/$defs/Nand"
    },
    "sd": {
      "description": "Files for the SD card, published in sd/ next to nand.bin and keys.bin.",
      "anyOf": [
        {
          "$ref": "#/$defs/Device"
        },
        {
          "type": "null"
        }
      ]
    },
    "usb": {
      "description": "Files for a USB drive, published in usb/.",
      "anyOf": [
        {
          "$ref": "#/$defs/Device"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "nand"
  ],
  "$defs": {
    "App": {
      "description": "A Homebrew Channel app. From an archive, its folder holding boot.dol or\nboot.elf becomes apps/<name>/, unless `extract` says what goes where.",
      "type": "object",
      "properties": {
        "extract": {
          "description": "Which archive files go where, relative to the app folder (/ is the folder\nitself). Without it, the archive must hold exactly one app folder.",
          "anyOf": [
            {
              "$ref": "#/$defs/Extract"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "description": "SHA-256 of the exact archive. Optional for a GitHub release asset whose\nrelease states one; required otherwise.",
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "description": "Local archive, relative to the recipe.",
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        },
        {
          "description": "HTTPS URL of the archive.",
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ]
        },
        {
          "description": "The archive itself, base64-encoded.",
          "type": "object",
          "properties": {
            "inline": {
              "type": "string",
              "contentEncoding": "base64"
            }
          },
          "required": [
            "inline"
          ]
        },
        {
          "description": "An archive attached to a tagged GitHub release.",
          "type": "object",
          "properties": {
            "github": {
              "$ref": "#/$defs/GithubAsset"
            }
          },
          "required": [
            "github"
          ]
        },
        {
          "description": "Loose files instead of an archive, by path inside the app folder.",
          "type": "object",
          "properties": {
            "files": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/LooseFile"
              }
            }
          },
          "required": [
            "files"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Aspect": {
      "description": "Screen aspect ratio.",
      "type": "string",
      "enum": [
        "4:3",
        "16:9"
      ]
    },
    "Autoboot": {
      "description": "Priiloader autoboot selection.",
      "type": "string",
      "enum": [
        "disabled",
        "homebrew_channel",
        "bootmii_ios",
        "system_menu",
        "file"
      ]
    },
    "Base": {
      "description": "Stock IOS a d2x cIOS is built on.",
      "type": "integer",
      "format": "uint8",
      "enum": [
        38,
        56,
        57,
        58
      ],
      "maximum": 255,
      "minimum": 0
    },
    "Bundle": {
      "description": "A file or archive placed from the device's root.",
      "type": "object",
      "properties": {
        "sha256": {
          "description": "SHA-256 of the exact file. Optional for a GitHub release asset whose\nrelease states one; required otherwise.",
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "description": "Local path, relative to the recipe.",
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ]
            },
            {
              "description": "HTTPS URL of the raw file.",
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "url"
              ]
            },
            {
              "description": "The file itself, base64-encoded.",
              "type": "object",
              "properties": {
                "inline": {
                  "type": "string",
                  "contentEncoding": "base64"
                }
              },
              "required": [
                "inline"
              ]
            },
            {
              "description": "An asset of a tagged GitHub release.",
              "type": "object",
              "properties": {
                "github": {
                  "$ref": "#/$defs/GithubAsset"
                }
              },
              "required": [
                "github"
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "description": "Unpack the whole archive into this directory.",
              "type": "object",
              "properties": {
                "unzip": {
                  "$ref": "#/$defs/CardPath"
                }
              },
              "required": [
                "unzip"
              ]
            },
            {
              "description": "Unpack the chosen archive files: see `Extract`.",
              "type": "object",
              "properties": {
                "extract": {
                  "$ref": "#/$defs/Extract"
                }
              },
              "required": [
                "extract"
              ]
            },
            {
              "description": "Copy the file to this path.",
              "type": "object",
              "properties": {
                "to": {
                  "$ref": "#/$defs/CardPath"
                }
              },
              "required": [
                "to"
              ]
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "CardPath": {
      "description": "A path on the SD card, relative to its root. A leading / is accepted and\nmeans the root; empty, `.` and `..` components are not.",
      "type": "string"
    },
    "Cios": {
      "description": "A prebuilt Wii d2x cIOS WAD and the slot it is expected to fill.",
      "type": "object",
      "properties": {
        "sha256": {
          "description": "SHA-256 of the exact WAD bytes.",
          "$ref": "#/$defs/Sha256"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "oneOf": [
        {
          "description": "Local path, relative to the recipe.",
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        },
        {
          "description": "HTTPS URL of the raw file.",
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ]
        },
        {
          "description": "The file itself, base64-encoded.",
          "type": "object",
          "properties": {
            "inline": {
              "type": "string",
              "contentEncoding": "base64"
            }
          },
          "required": [
            "inline"
          ]
        },
        {
          "description": "An asset of a tagged GitHub release.",
          "type": "object",
          "properties": {
            "github": {
              "$ref": "#/$defs/GithubAsset"
            }
          },
          "required": [
            "github"
          ]
        }
      ],
      "required": [
        "sha256",
        "target"
      ],
      "unevaluatedProperties": false
    },
    "CountryCode": {
      "description": "Supported ISO alpha-2 country code and its Wii SYSCONF byte.",
      "type": "string",
      "enum": [
        "JP",
        "AI",
        "AG",
        "AR",
        "AW",
        "BS",
        "BB",
        "BZ",
        "BO",
        "BR",
        "VG",
        "CA",
        "KY",
        "CL",
        "CO",
        "CR",
        "DM",
        "DO",
        "EC",
        "SV",
        "GF",
        "GD",
        "GP",
        "GT",
        "GY",
        "HT",
        "HN",
        "JM",
        "MQ",
        "MX",
        "MS",
        "AN",
        "NI",
        "PA",
        "PY",
        "PE",
        "KN",
        "LC",
        "VC",
        "SR",
        "TT",
        "TC",
        "US",
        "UY",
        "VI",
        "VE",
        "AU",
        "AT",
        "BE",
        "DK",
        "FI",
        "FR",
        "DE",
        "GR",
        "IE",
        "IT",
        "LU",
        "NL",
        "NZ",
        "NO",
        "PL",
        "PT",
        "RO",
        "ES",
        "SE",
        "CH",
        "GB"
      ]
    },
    "Device": {
      "description": "The files of an SD card or a USB drive.",
      "type": "object",
      "properties": {
        "apps": {
          "description": "Homebrew apps. Each key is the folder apps/<key>/ the app goes in.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/App"
          }
        },
        "bundles": {
          "description": "Anything else, placed from the device's root: packages spanning several\nroot folders, single files, covers.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Bundle"
          }
        }
      },
      "additionalProperties": false
    },
    "Display": {
      "description": "Display configuration applied during first-run setup.",
      "type": "object",
      "properties": {
        "aspect": {
          "description": "Set 4:3 or widescreen output (defaults to 4:3).",
          "$ref": "#/$defs/Aspect",
          "default": "4:3"
        },
        "pal60": {
          "description": "Enable PAL 60 Hz mode (defaults to off).",
          "type": "boolean",
          "default": false
        },
        "progressive": {
          "description": "Enable progressive 480p output when supported (defaults to off).",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Extract": {
      "description": "Which archive files go where. Each key is a glob over paths inside the\narchive (`*`, `**`, `?`, `[…]`, `{a,b}`); each value a directory. A matching\nfile keeps its path below the glob's fixed leading folders: with\n`\"pkg/data/**\": /data/`, `pkg/data/x/y` lands at `/data/x/y`. Files no glob\nmatches are left out; a glob matching nothing, or a file matching two, is\nan error.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CardPath"
      }
    },
    "GithubAsset": {
      "description": "An asset of a tagged GitHub release.",
      "type": "object",
      "properties": {
        "asset": {
          "description": "Asset file name, such as usbloadergx_r1283.zip.",
          "type": "string"
        },
        "repo": {
          "description": "Repository as owner/name, such as wiidev/usbloadergx.",
          "type": "string"
        },
        "tag": {
          "description": "Release tag, such as v4.0-r1283.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "repo",
        "tag",
        "asset"
      ]
    },
    "Hack": {
      "description": "A System Menu hack from the pinned Priiloader 0.10.0 definitions. Descriptions\nfollow Priiloader's docs/HACKSLIST.md.",
      "oneOf": [
        {
          "description": "Fixes an image display issue of the System Menu in 480p (analog video only).\nIt fixes the System Menu, not games.",
          "type": "string",
          "const": "fix_480p"
        },
        {
          "description": "Makes System Menu updates fail (error 32007), to stay on this System Menu.",
          "type": "string",
          "const": "block_online_updates"
        },
        {
          "description": "Skips the \"Wii System Update\" some game discs force before playing.",
          "type": "string",
          "const": "block_disc_updates"
        },
        {
          "description": "Stops discs whose ID starts with 0 or 1 (diagnostic discs) from booting automatically.",
          "type": "string",
          "const": "block_disc_autoboot"
        },
        {
          "description": "Presses A automatically to get past the health and safety screen.",
          "type": "string",
          "const": "auto_press_a"
        },
        {
          "description": "Disables the System Menu's blur filter; recommended with 480p.",
          "type": "string",
          "const": "remove_deflicker"
        },
        {
          "description": "Lets the Disc Channel be moved like any channel (hold A+B).",
          "type": "string",
          "const": "move_disc_channel"
        },
        {
          "description": "Lets Data Management copy save files that are normally protected from copying\nto the SD card. It does not allow moving them.",
          "type": "string",
          "const": "remove_nocopy_save_protection"
        },
        {
          "description": "Skips the health warning screen and goes straight to the channels.",
          "type": "string",
          "const": "replace_health_screen"
        },
        {
          "description": "Disables the System Menu's background music.",
          "type": "string",
          "const": "no_background_music"
        },
        {
          "description": "Patches disc games launched from the Disc Channel to use Wiimmfi (not WiiWare).",
          "type": "string",
          "const": "wiimmfi"
        },
        {
          "description": "Unblocks region-locked Wii and GameCube discs and channels (WiiWare, VC). Not every\ngame works; video modes may misbehave. The Japanese menu uses the JP definition.",
          "type": "string",
          "const": "region_free_everything"
        },
        {
          "description": "Disables the System Menu's sound effects and background music.",
          "type": "string",
          "const": "no_sfx_and_background_music"
        },
        {
          "description": "Re-enables the Bannerbomb exploit on 4.3. Not needed with the Homebrew Channel.",
          "type": "string",
          "const": "re_enable_bannerbomb"
        },
        {
          "description": "Sends the Wii Menu's logs to a USB Gecko in memory card slot B.",
          "type": "string",
          "const": "usb_gecko_report"
        },
        {
          "description": "Sends the Wii Menu's logs to a USB Gecko in slot B when Gecko OS launched the menu.",
          "type": "string",
          "const": "usb_gecko_report_geckoos"
        },
        {
          "description": "Boots straight into Data Management. Can help with a banner brick by deleting\nthe channel data causing it.",
          "type": "string",
          "const": "force_data_management"
        },
        {
          "description": "Starts the console in recovery mode, to launch recovery discs.",
          "type": "string",
          "const": "force_recovery_mode"
        },
        {
          "description": "In recovery mode, lets any disc boot instead of waiting for the Wii Backup Disc.",
          "type": "string",
          "const": "remove_diagnostic_disc_check"
        },
        {
          "description": "Prevents the System Menu from deleting the Homebrew Channel, DVDX and others\n(HAXX, JODI, DVDX, DISC, DISK, RZDx).",
          "type": "string",
          "const": "no_delete_homebrew"
        },
        {
          "description": "Runs disc games under IOS248, for a cIOS installed there. Disc games without\none there stop working.",
          "type": "string",
          "const": "force_disc_ios248"
        },
        {
          "description": "Runs disc games under IOS249 (see force_disc_ios248).",
          "type": "string",
          "const": "force_disc_ios249"
        },
        {
          "description": "Runs disc games under IOS250 (see force_disc_ios248).",
          "type": "string",
          "const": "force_disc_ios250"
        },
        {
          "description": "Runs disc games under IOS251 (see force_disc_ios248).",
          "type": "string",
          "const": "force_disc_ios251"
        },
        {
          "description": "Unblocks service discs: the Wii Startup Disc and the Wii Backup Discs.",
          "type": "string",
          "const": "unblock_service_discs"
        },
        {
          "description": "Stops the System Menu from blocking discs that use IOS16 (the Wii Backup Disc).",
          "type": "string",
          "const": "remove_ios16_disc_error"
        },
        {
          "description": "Marks the network connection as tested, so \"Use this connection\" works\nwithout running the test.",
          "type": "string",
          "const": "mark_network_tested"
        }
      ]
    },
    "Hbc": {
      "description": "Homebrew Channel to install before Priiloader is configured.",
      "oneOf": [
        {
          "description": "Download the retail OHBC WAD from a tagged HBC Reborn release.",
          "type": "object",
          "properties": {
            "reborn": {
              "type": "object",
              "properties": {
                "sha256": {
                  "description": "Optional WAD checksum. Defaults to the GitHub release asset digest.",
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Sha256"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "version": {
                  "description": "Semantic version without the leading v.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "version"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "reborn"
          ]
        },
        {
          "description": "Install a user-supplied, hash-pinned Homebrew Channel WAD.",
          "type": "object",
          "properties": {
            "custom": {
              "$ref": "#/$defs/Wad"
            }
          },
          "additionalProperties": false,
          "required": [
            "custom"
          ]
        }
      ]
    },
    "Language": {
      "description": "Wii first-run language.",
      "type": "string",
      "enum": [
        "ja",
        "en",
        "de",
        "fr",
        "es",
        "it",
        "nl"
      ]
    },
    "LooseFile": {
      "description": "One loose file of an app.",
      "type": "object",
      "properties": {
        "sha256": {
          "description": "SHA-256 of the exact file. Optional for a GitHub release asset whose\nrelease states one; required otherwise.",
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "description": "Local path, relative to the recipe.",
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        },
        {
          "description": "HTTPS URL of the raw file.",
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ]
        },
        {
          "description": "The file itself, base64-encoded.",
          "type": "object",
          "properties": {
            "inline": {
              "type": "string",
              "contentEncoding": "base64"
            }
          },
          "required": [
            "inline"
          ]
        },
        {
          "description": "An asset of a tagged GitHub release.",
          "type": "object",
          "properties": {
            "github": {
              "$ref": "#/$defs/GithubAsset"
            }
          },
          "required": [
            "github"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Menu": {
      "description": "Stock System Menu version used by the generated image.",
      "oneOf": [
        {
          "description": "European 4.3 menu.",
          "type": "string",
          "const": "4.3E"
        },
        {
          "description": "North American 4.3 menu.",
          "type": "string",
          "const": "4.3U"
        },
        {
          "description": "Japanese 4.3 menu.",
          "type": "string",
          "const": "4.3J"
        }
      ]
    },
    "MountPoint": {
      "description": "Preferred storage device for Priiloader file operations.",
      "type": "string",
      "enum": [
        "auto",
        "sd",
        "usb"
      ]
    },
    "Nand": {
      "description": "The NAND image: stock menu, then everything installed on top of it.",
      "type": "object",
      "properties": {
        "cios": {
          "description": "Prebuilt, hash-pinned Wii d2x cIOS WADs.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cios"
          }
        },
        "hbc": {
          "description": "Optional Homebrew Channel from a tagged Reborn release or a custom WAD.",
          "anyOf": [
            {
              "$ref": "#/$defs/Hbc"
            },
            {
              "type": "null"
            }
          ]
        },
        "menu": {
          "description": "Stock System Menu target (4.3E, 4.3U, or 4.3J).",
          "$ref": "#/$defs/Menu"
        },
        "priiloader": {
          "description": "Optional pinned Priiloader install with its settings and hacks.",
          "anyOf": [
            {
              "$ref": "#/$defs/Priiloader"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "remove": {
          "description": "Stock channels to remove.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RemovableChannel"
          },
          "uniqueItems": true
        },
        "rvloader": {
          "description": "Optional RVLoader boot hook. Requires `priiloader`.",
          "anyOf": [
            {
              "$ref": "#/$defs/Rvloader"
            },
            {
              "type": "null"
            }
          ]
        },
        "setup": {
          "description": "Supply a mapping to complete first-run setup with these settings and defaults.\nOmit this section or use null to run the Wii setup wizard.",
          "anyOf": [
            {
              "$ref": "#/$defs/Setup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "titles": {
          "description": "WADs to install from a local file, inline bytes, or an HTTPS URL.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Title"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "menu"
      ]
    },
    "Nickname": {
      "description": "Console nickname with 1–10 BMP letters, numbers, or spaces, including a letter or number.",
      "type": "string",
      "maxLength": 10,
      "minLength": 1
    },
    "Priiloader": {
      "description": "Complete Priiloader configuration. Applying it writes every setting and\nhack state, replacing what the NAND holds; omitted values use the pinned\n0.10.0 defaults.",
      "type": "object",
      "properties": {
        "autoboot": {
          "description": "Autoboot destination. Defaults to the System Menu.",
          "anyOf": [
            {
              "$ref": "#/$defs/Autoboot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dump_gecko_text": {
          "description": "Dump Gecko output.",
          "type": "boolean",
          "default": false
        },
        "hacks": {
          "description": "Hacks to enable. Every other hack is disabled.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Hack"
          },
          "uniqueItems": true
        },
        "ignore_shutdown_mode": {
          "description": "Ignore standby mode.",
          "type": "boolean",
          "default": false
        },
        "lid_slot_on_error": {
          "description": "Light the drive slot when an error occurs.",
          "type": "boolean",
          "default": false
        },
        "preferred_mount_point": {
          "description": "Preferred storage device. Defaults to automatic.",
          "$ref": "#/$defs/MountPoint",
          "default": "auto"
        },
        "return_to": {
          "description": "Destination used by Priiloader's Return to option. Defaults to the System Menu.",
          "anyOf": [
            {
              "$ref": "#/$defs/ReturnTo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "show_rc_updates": {
          "description": "Show Priiloader update notices.",
          "type": "boolean",
          "default": false
        },
        "shutdown_to": {
          "description": "Shutdown destination. Defaults to none.",
          "$ref": "#/$defs/ShutdownTo",
          "default": "none"
        },
        "stop_disc": {
          "description": "Stop the disc drive at startup.",
          "type": "boolean",
          "default": false
        },
        "white_background": {
          "description": "Use a white background instead of the default black one.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "RemovableChannel": {
      "description": "A stock channel that `remove` can take off the image.",
      "oneOf": [
        {
          "description": "The menu region's Forecast Channel and its common stub.",
          "type": "string",
          "const": "forecast-channel"
        },
        {
          "description": "The menu region's News Channel and its common stub.",
          "type": "string",
          "const": "news-channel"
        },
        {
          "description": "Wii Shop Channel (HABA).",
          "type": "string",
          "const": "wii-shop-channel"
        },
        {
          "description": "Photo Channel versions HAAA and HAYA.",
          "type": "string",
          "const": "photo-channel"
        }
      ]
    },
    "ReturnTo": {
      "description": "Priiloader return destination.",
      "type": "string",
      "enum": [
        "system_menu",
        "priiloader",
        "autoboot",
        "file"
      ]
    },
    "Rvloader": {
      "description": "What RVLoader's installer does, done offline: Priiloader starts RVLoader's\nbootloader, which loads RVLoader from USB, and the IOS slots 236, 240 and\n241 get copies of IOS36 (patched), IOS58 and IOS80 without the stock Wi-Fi\nmodules. The recipe needs a `priiloader` section without `autoboot` and\n`return_to`. The RVLoader release itself goes on the USB drive.",
      "type": "object",
      "properties": {
        "patch_out_wifi": {
          "description": "The installer's \"Patch out WiFi\": IOS36, IOS58 and IOS80 lose their\nWi-Fi modules too. Either way they are reinstalled as the installer does.",
          "type": "boolean"
        },
        "sha256": {
          "description": "SHA-256 of that release's `installer/data/bootloader.dol`.",
          "$ref": "#/$defs/Sha256"
        },
        "version": {
          "description": "RVLoader release, such as \"2.1\".",
          "$ref": "#/$defs/RvloaderVersion"
        },
        "vga": {
          "description": "The installer's \"Enable VGA\". Needs `setup.display.progressive`, and\n`pal60` for 4.3E. Component video then stops working.",
          "type": "boolean"
        },
        "wd_sha256": {
          "description": "SHA-256 of that release's `installer/data/wd.bin`, the Wi-Fi driver\nreplacing the stock Wi-Fi modules.",
          "$ref": "#/$defs/Sha256"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "wd_sha256",
        "patch_out_wifi",
        "vga"
      ]
    },
    "RvloaderVersion": {
      "description": "RVLoader release number: major.minor, without the leading v.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "SensorBar": {
      "description": "Sensor bar position relative to the display.",
      "type": "string",
      "enum": [
        "above",
        "below"
      ]
    },
    "Setup": {
      "description": "First-run setup values written to SYSCONF.",
      "type": "object",
      "properties": {
        "country": {
          "description": "Wii-supported ISO alpha-2 code, such as GB, US, or JP. Quote \"NO\" in YAML.\nDefaults to GB, US, or JP for the menu's region.",
          "anyOf": [
            {
              "$ref": "#/$defs/CountryCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "display": {
          "description": "Display settings. Omit this mapping to use the display defaults.",
          "$ref": "#/$defs/Display",
          "default": {
            "aspect": "4:3",
            "pal60": false,
            "progressive": false
          }
        },
        "language": {
          "description": "Setup language, constrained by the effective menu region.\nDefaults to en for 4.3E and 4.3U, and ja for 4.3J.",
          "anyOf": [
            {
              "$ref": "#/$defs/Language"
            },
            {
              "type": "null"
            }
          ]
        },
        "nickname": {
          "description": "Console nickname. Defaults to the Wii's factory name.",
          "$ref": "#/$defs/Nickname",
          "default": "Wii"
        },
        "sensor_bar": {
          "description": "Physical sensor bar position. Defaults to above the display.",
          "$ref": "#/$defs/SensorBar",
          "default": "above"
        }
      },
      "additionalProperties": false
    },
    "Sha256": {
      "description": "SHA-256 of the exact binary payload, encoded as 64 hex digits.",
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "ShutdownTo": {
      "description": "Priiloader shutdown destination.",
      "type": "string",
      "enum": [
        "none",
        "priiloader",
        "autoboot"
      ]
    },
    "Slot": {
      "description": "IOS slot a cIOS may be installed to.",
      "type": "integer",
      "format": "uint8",
      "enum": [
        248,
        249,
        250,
        251
      ],
      "maximum": 255,
      "minimum": 0
    },
    "Target": {
      "description": "Expected identity and replacement policy for a prebuilt Wii d2x WAD.",
      "type": "object",
      "properties": {
        "base": {
          "description": "Base IOS declared by the d2x payload.",
          "$ref": "#/$defs/Base"
        },
        "replace_stock_stub": {
          "description": "Permit replacement of the verified Nintendo stub in slot 249 or 250.",
          "type": "boolean",
          "default": false
        },
        "revision": {
          "description": "TMD title revision, such as 65535.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "slot": {
          "description": "Destination IOS slot (248–251).",
          "$ref": "#/$defs/Slot"
        }
      },
      "additionalProperties": false,
      "required": [
        "slot",
        "base",
        "revision"
      ]
    },
    "Title": {
      "description": "A WAD to install when its title is absent, or to verify when it is present.",
      "type": "object",
      "properties": {
        "allow_unsigned": {
          "description": "Permit an unsigned community channel after content validation.\nBy default the WAD must carry Nintendo signatures.",
          "type": "boolean",
          "default": false
        },
        "sha256": {
          "description": "SHA-256 of the exact WAD bytes.",
          "$ref": "#/$defs/Sha256"
        }
      },
      "oneOf": [
        {
          "description": "Local path, relative to the recipe.",
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        },
        {
          "description": "HTTPS URL of the raw file.",
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ]
        },
        {
          "description": "The file itself, base64-encoded.",
          "type": "object",
          "properties": {
            "inline": {
              "type": "string",
              "contentEncoding": "base64"
            }
          },
          "required": [
            "inline"
          ]
        },
        {
          "description": "An asset of a tagged GitHub release.",
          "type": "object",
          "properties": {
            "github": {
              "$ref": "#/$defs/GithubAsset"
            }
          },
          "required": [
            "github"
          ]
        }
      ],
      "required": [
        "sha256"
      ],
      "unevaluatedProperties": false
    },
    "Wad": {
      "description": "A WAD from one source, with the SHA-256 of its exact bytes.",
      "type": "object",
      "properties": {
        "sha256": {
          "description": "SHA-256 of the exact WAD bytes.",
          "$ref": "#/$defs/Sha256"
        }
      },
      "oneOf": [
        {
          "description": "Local path, relative to the recipe.",
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        },
        {
          "description": "HTTPS URL of the raw file.",
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ]
        },
        {
          "description": "The file itself, base64-encoded.",
          "type": "object",
          "properties": {
            "inline": {
              "type": "string",
              "contentEncoding": "base64"
            }
          },
          "required": [
            "inline"
          ]
        },
        {
          "description": "An asset of a tagged GitHub release.",
          "type": "object",
          "properties": {
            "github": {
              "$ref": "#/$defs/GithubAsset"
            }
          },
          "required": [
            "github"
          ]
        }
      ],
      "required": [
        "sha256"
      ],
      "unevaluatedProperties": false
    }
  }
}
