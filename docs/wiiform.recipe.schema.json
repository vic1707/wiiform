{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recipe",
  "type": "object",
  "properties": {
    "cios": {
      "description": "Prebuilt, hash-pinned Wii d2x cIOS WADs.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Cios"
      }
    },
    "menu": {
      "description": "Stock System Menu target (4.3E, 4.3U, or 4.3J).",
      "$ref": "#/$defs/Menu"
    },
    "priiloader": {
      "description": "Optional pinned Priiloader install with settings and hacks.",
      "anyOf": [
        {
          "$ref": "#/$defs/Priiloader"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "remove": {
      "description": "Channels to remove. Names expand using the effective menu's region.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RemovalInput"
      }
    },
    "setup": {
      "description": "Supply a mapping to complete first-run setup with these settings and defaults.\nOmit this section or use null to run the Wii setup wizard.",
      "anyOf": [
        {
          "$ref": "#/$defs/Setup"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "titles": {
      "description": "WADs to install from a file or inline bytes.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Title"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "menu"
  ],
  "$defs": {
    "Aspect": {
      "description": "Screen aspect ratio.",
      "type": "string",
      "enum": [
        "4:3",
        "16:9"
      ]
    },
    "Autoboot": {
      "description": "Priiloader autoboot selection.",
      "type": "string",
      "enum": [
        "disabled",
        "homebrew_channel",
        "bootmii_ios",
        "system_menu",
        "file"
      ]
    },
    "Binary": {
      "description": "Bytes stored as a YAML `!!binary` scalar.",
      "type": "string",
      "contentEncoding": "base64"
    },
    "Cios": {
      "type": "object",
      "properties": {
        "sha256": {
          "description": "SHA-256 of the exact WAD bytes.",
          "$ref": "#/$defs/Sha256"
        },
        "source": {
          "$ref": "#/$defs/Data"
        },
        "target": {
          "$ref": "#/$defs/CiosTarget"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "sha256",
        "target"
      ]
    },
    "CiosTarget": {
      "description": "Expected identity and replacement policy for a prebuilt Wii d2x WAD.",
      "type": "object",
      "properties": {
        "base": {
          "description": "Base IOS declared by the d2x payload.",
          "type": "integer",
          "format": "uint8",
          "enum": [
            38,
            56,
            57,
            58
          ],
          "maximum": 255,
          "minimum": 0
        },
        "replace_stock_stub": {
          "description": "Permit replacement of the verified Nintendo stub in slot 249 or 250.",
          "type": "boolean",
          "default": false
        },
        "revision": {
          "description": "TMD title revision, such as 65535.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "slot": {
          "description": "Destination IOS slot (248–251).",
          "type": "integer",
          "format": "uint8",
          "maximum": 251,
          "minimum": 248
        }
      },
      "additionalProperties": false,
      "required": [
        "slot",
        "base",
        "revision"
      ]
    },
    "CountryCode": {
      "description": "Supported ISO alpha-2 country code and its Wii SYSCONF byte.",
      "type": "string",
      "enum": [
        "JP",
        "AI",
        "AG",
        "AR",
        "AW",
        "BS",
        "BB",
        "BZ",
        "BO",
        "BR",
        "VG",
        "CA",
        "KY",
        "CL",
        "CO",
        "CR",
        "DM",
        "DO",
        "EC",
        "SV",
        "GF",
        "GD",
        "GP",
        "GT",
        "GY",
        "HT",
        "HN",
        "JM",
        "MQ",
        "MX",
        "MS",
        "AN",
        "NI",
        "PA",
        "PY",
        "PE",
        "KN",
        "LC",
        "VC",
        "SR",
        "TT",
        "TC",
        "US",
        "UY",
        "VI",
        "VE",
        "AU",
        "AT",
        "BE",
        "DK",
        "FI",
        "FR",
        "DE",
        "GR",
        "IE",
        "IT",
        "LU",
        "NL",
        "NZ",
        "NO",
        "PL",
        "PT",
        "RO",
        "ES",
        "SE",
        "CH",
        "GB"
      ]
    },
    "Data": {
      "description": "Data supplied by one local file or inline in a recipe.",
      "oneOf": [
        {
          "description": "Local path, relative to the recipe.",
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "path"
          ]
        },
        {
          "description": "Data carried in the recipe itself.",
          "type": "object",
          "properties": {
            "inline": {
              "$ref": "#/$defs/Binary"
            }
          },
          "additionalProperties": false,
          "required": [
            "inline"
          ]
        }
      ]
    },
    "Display": {
      "description": "Display configuration applied during first-run setup.",
      "type": "object",
      "properties": {
        "aspect": {
          "description": "Set 4:3 or widescreen output (defaults to 4:3).",
          "$ref": "#/$defs/Aspect",
          "default": "4:3"
        },
        "pal60": {
          "description": "Enable PAL 60 Hz mode (defaults to off).",
          "type": "boolean",
          "default": false
        },
        "progressive": {
          "description": "Enable progressive 480p output when supported (defaults to off).",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "HackSettings": {
      "description": "Complete supported System Menu hack state. Each hack defaults to off.",
      "type": "object",
      "properties": {
        "auto_press_a": {
          "description": "Auto-press A at the health screen.",
          "type": "boolean",
          "default": false
        },
        "block_disc_autoboot": {
          "description": "Block disc autoboot.",
          "type": "boolean",
          "default": false
        },
        "block_disc_updates": {
          "description": "Block disc updates.",
          "type": "boolean",
          "default": false
        },
        "block_online_updates": {
          "description": "Block online updates.",
          "type": "boolean",
          "default": false
        },
        "fix_480p": {
          "description": "Fix 480p graphics in the System Menu.",
          "type": "boolean",
          "default": false
        },
        "move_disc_channel": {
          "description": "Move the Disc Channel.",
          "type": "boolean",
          "default": false
        },
        "no_background_music": {
          "description": "Disable System Menu background music.",
          "type": "boolean",
          "default": false
        },
        "region_free_everything": {
          "description": "Enable Region Free EVERYTHING (Japanese menu uses the JP hack name).",
          "type": "boolean",
          "default": false
        },
        "remove_deflicker": {
          "description": "Remove deflicker.",
          "type": "boolean",
          "default": false
        },
        "remove_nocopy_save_protection": {
          "description": "Remove NoCopy save protection.",
          "type": "boolean",
          "default": false
        },
        "replace_health_screen": {
          "description": "Replace the health screen with Backmenu.",
          "type": "boolean",
          "default": false
        },
        "wiimmfi": {
          "description": "Apply the Wiimmfi patch.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Language": {
      "description": "Wii first-run language value written to SYSCONF.",
      "type": "string",
      "enum": [
        "ja",
        "en",
        "de",
        "fr",
        "es",
        "it",
        "nl"
      ]
    },
    "Menu": {
      "description": "Stock System Menu version used by the generated image.",
      "oneOf": [
        {
          "description": "European 4.3 menu.",
          "type": "string",
          "const": "4.3E"
        },
        {
          "description": "North American 4.3 menu.",
          "type": "string",
          "const": "4.3U"
        },
        {
          "description": "Japanese 4.3 menu.",
          "type": "string",
          "const": "4.3J"
        }
      ]
    },
    "MountPoint": {
      "description": "Preferred storage device for Priiloader file operations.",
      "type": "string",
      "enum": [
        "auto",
        "sd",
        "usb"
      ]
    },
    "Nickname": {
      "description": "Console nickname with 1–10 BMP letters, numbers, or spaces, including a letter or number.",
      "type": "string",
      "maxLength": 10,
      "minLength": 1
    },
    "Priiloader": {
      "description": "Priiloader installation and configuration.",
      "type": "object",
      "properties": {
        "hacks": {
          "description": "Complete state for supported hacks. Unlisted hacks default to off.",
          "anyOf": [
            {
              "$ref": "#/$defs/HackSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": {
            "auto_press_a": false,
            "block_disc_autoboot": false,
            "block_disc_updates": false,
            "block_online_updates": false,
            "fix_480p": false,
            "move_disc_channel": false,
            "no_background_music": false,
            "region_free_everything": false,
            "remove_deflicker": false,
            "remove_nocopy_save_protection": false,
            "replace_health_screen": false,
            "wiimmfi": false
          }
        },
        "settings": {
          "description": "Complete settings. Omitted values use pinned Priiloader defaults.",
          "anyOf": [
            {
              "$ref": "#/$defs/PriiloaderSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": {
            "autoboot": "system_menu",
            "black_background": true,
            "dump_gecko_text": false,
            "ignore_shutdown_mode": false,
            "lid_slot_on_error": false,
            "preferred_mount_point": "auto",
            "return_to": "system_menu",
            "show_rc_updates": false,
            "shutdown_to": "none",
            "stop_disc": false
          }
        }
      },
      "additionalProperties": false
    },
    "PriiloaderSettings": {
      "description": "Complete Priiloader settings written to its settings file.\n\nMissing recipe values use the pinned 0.10.0 defaults. Applying this type\nwrites every configurable setting, replacing values already present in NAND.",
      "type": "object",
      "properties": {
        "autoboot": {
          "description": "Autoboot destination. Defaults to the System Menu.",
          "$ref": "#/$defs/Autoboot",
          "default": "system_menu"
        },
        "black_background": {
          "description": "Use a black background. The pinned default is on.",
          "type": "boolean",
          "default": true
        },
        "dump_gecko_text": {
          "description": "Dump Gecko output. Defaults to off.",
          "type": "boolean",
          "default": false
        },
        "ignore_shutdown_mode": {
          "description": "Ignore standby mode. Defaults to off.",
          "type": "boolean",
          "default": false
        },
        "lid_slot_on_error": {
          "description": "Light the drive slot when an error occurs. Defaults to off.",
          "type": "boolean",
          "default": false
        },
        "preferred_mount_point": {
          "description": "Preferred storage device. Defaults to automatic.",
          "$ref": "#/$defs/MountPoint",
          "default": "auto"
        },
        "return_to": {
          "description": "Destination used by Priiloader's Return to option.",
          "$ref": "#/$defs/ReturnTo",
          "default": "system_menu"
        },
        "show_rc_updates": {
          "description": "Show Priiloader update notices. Defaults to off.",
          "type": "boolean",
          "default": false
        },
        "shutdown_to": {
          "description": "Shutdown destination. Defaults to none.",
          "$ref": "#/$defs/ShutdownTo",
          "default": "none"
        },
        "stop_disc": {
          "description": "Stop the disc drive at startup. Defaults to off.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "RemovalInput": {
      "description": "One removal entry as written in a recipe: a known name or quoted title ID.",
      "anyOf": [
        {
          "description": "Supported channel name.",
          "$ref": "#/$defs/RemovalName"
        },
        {
          "description": "A quoted title ID from the removal allowlist.",
          "$ref": "#/$defs/TitleId"
        }
      ]
    },
    "RemovalName": {
      "description": "Channel shortcuts supported by `remove`.",
      "oneOf": [
        {
          "description": "Expand to the forecast channel title for the selected menu and its common stub.",
          "type": "string",
          "const": "forecast-channel"
        },
        {
          "description": "Expand to the news channel title for the selected menu and its common stub.",
          "type": "string",
          "const": "news-channel"
        },
        {
          "description": "Wii Shop Channel (HABA).",
          "type": "string",
          "const": "wii-shop-channel"
        },
        {
          "description": "Photo Channel versions HAAA and HAYA.",
          "type": "string",
          "const": "photo-channel"
        }
      ]
    },
    "ReturnTo": {
      "description": "Priiloader return destination.",
      "type": "string",
      "enum": [
        "system_menu",
        "priiloader",
        "autoboot",
        "file"
      ]
    },
    "SensorBar": {
      "description": "Sensor bar position relative to the display.",
      "type": "string",
      "enum": [
        "above",
        "below"
      ]
    },
    "Setup": {
      "description": "First-run setup values written to SYSCONF.",
      "type": "object",
      "properties": {
        "country": {
          "description": "Wii-supported ISO alpha-2 code, such as GB, US, or JP. Quote \"NO\" in YAML.",
          "anyOf": [
            {
              "$ref": "#/$defs/CountryCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "display": {
          "description": "Display settings. Omit this mapping to use the display defaults.",
          "$ref": "#/$defs/Display",
          "default": {
            "aspect": "4:3",
            "pal60": false,
            "progressive": false
          }
        },
        "language": {
          "description": "Setup language, constrained by the effective menu region.",
          "anyOf": [
            {
              "$ref": "#/$defs/Language"
            },
            {
              "type": "null"
            }
          ]
        },
        "nickname": {
          "description": "Console nickname. Defaults to the Wii's factory name.",
          "$ref": "#/$defs/Nickname",
          "default": "Wii"
        },
        "sensor_bar": {
          "description": "Physical sensor bar position. Defaults to above the display.",
          "$ref": "#/$defs/SensorBar",
          "default": "above"
        }
      },
      "additionalProperties": false
    },
    "Sha256": {
      "description": "SHA-256 of the exact binary payload, encoded as 64 hex digits.",
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "ShutdownTo": {
      "description": "Priiloader shutdown destination.",
      "type": "string",
      "enum": [
        "none",
        "priiloader",
        "autoboot"
      ]
    },
    "SignaturePolicy": {
      "description": "WAD signature requirements.",
      "oneOf": [
        {
          "description": "Require Nintendo signatures.",
          "type": "string",
          "const": "nintendo"
        },
        {
          "description": "Permit an unsigned community channel after content validation.",
          "type": "string",
          "const": "allow-unsigned"
        }
      ]
    },
    "Title": {
      "type": "object",
      "properties": {
        "sha256": {
          "description": "SHA-256 of the exact WAD bytes.",
          "$ref": "#/$defs/Sha256"
        },
        "signature_policy": {
          "$ref": "#/$defs/SignaturePolicy"
        },
        "source": {
          "$ref": "#/$defs/Data"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "sha256"
      ]
    },
    "TitleId": {
      "description": "Nonzero Wii title ID written as 16 hex digits.",
      "type": "string",
      "maxLength": 16,
      "minLength": 16,
      "not": {
        "const": "0000000000000000"
      },
      "pattern": "^[0-9a-fA-F]{16}$"
    }
  }
}
